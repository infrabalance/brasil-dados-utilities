# Copie para .env (fora do git). Tudo aqui é opcional.

# Séries do Hidroweb (ANA): cadastro gratuito no serviço Hidroweb da ANA.
# Sem estas duas, `npm run coletar` pula o Hidroweb.
ANA_HIDRO_IDENTIFICADOR=
ANA_HIDRO_SENHA=

# Estações a coletar (códigos de agua.estacoes). Sem isto vale config/hidroweb-estacoes.json.
# BDU_HIDROWEB_ESTACOES=14990000,29050000
# Dias de telemetria (padrão 365) e requisições simultâneas à ANA (padrão 4).
# BDU_HIDROWEB_TELEMETRIA_DIAS=365
# BDU_HIDROWEB_SIMULTANEAS=4
